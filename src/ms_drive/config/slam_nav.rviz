Visualization Manager:
  Displays:
    - Name: TF
      Class: rviz_default_plugins/TF
      Enabled: true
    - Name: RobotModel
      Class: rviz_default_plugins/RobotModel
      Enabled: true
      Robot Description: robot_description
    - Name: Map
      Class: rviz_default_plugins/Map
      Enabled: true
      Topic: /map
    - Name: LaserScan
      Class: rviz_default_plugins/LaserScan
      Enabled: true
      Topic: /scan_raw
    - Name: Wheel Odom Path
      Class: rviz_default_plugins/Path
      Enabled: true
      Topic: /odom  # published by your wheel odom
      Color: 255;0;0  # red
      Buffer Length: 1000
      Line Style: Lines
    - Name: SLAM Path
      Class: rviz_default_plugins/Path
      Enabled: true
      Topic: /slam_toolbox/trajectory  # published by slam_toolbox
      Color: 0;255;0  # green
      Buffer Length: 1000
      Line Style: Lines

  Global Options:
    Fixed Frame: map
